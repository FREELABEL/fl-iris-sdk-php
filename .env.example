# IRIS SDK Configuration
# ======================
# Copy this file to .env and fill in your credentials.
# Get your API key from the Developer Portal in any project.

# ========================================
# ENVIRONMENT SWITCHING
# ========================================
# Set to 'local' or 'production' to switch between environments
# You can also override at runtime: env IRIS_ENV=local ./bin/iris sdk:call ...
IRIS_ENV=production

# User ID (same for both environments)
IRIS_USER_ID=193

# ========================================
# API KEYS (Environment-Specific)
# ========================================
# Production API key (used when IRIS_ENV=production)
IRIS_PROD_API_KEY=your_production_sdk_key_from_developer_portal

# Local development API key (used when IRIS_ENV=local)
IRIS_LOCAL_API_KEY=your_local_sdk_key_from_developer_portal

# Fallback API key (used if environment-specific key not found)
IRIS_API_KEY=your_default_sdk_key

# ========================================
# IRIS API - agents, chat, workflows
# ========================================
IRIS_API_URL=https://iris-api.freelabel.net
IRIS_LOCAL_URL=https://local.iris.freelabel.net

# ========================================
# FL-API - leads, deliverables, profiles
# ========================================
FL_API_URL=https://apiv2.heyiris.io
FL_API_LOCAL_URL=https://local.raichu.freelabel.net

# ========================================
# Optional: OAuth credentials (advanced)
# ========================================
# IRIS_CLIENT_ID=your-oauth-client-id
# IRIS_CLIENT_SECRET=your-oauth-client-secret
